{
  "name": "blob",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny floating bubble: tell your computer what to do, by voice or text. Runs your own Claude Code with clawdcursor as its hands.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "pack:npm": "node build.mjs && node scripts/pack.mjs && cd release/npm && npm pack",
    "build:phone": "node phone/build.mjs",
    "build:site": "node site/build.mjs",
    "check:phone": "tsc -p phone && tsc -p relay",
    "start": "node build.mjs && tsx src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@webviewjs/webview": "^0.6.0",
    "border-beam": "^1.4.1",
    "koffi": "^3.3.8",
    "liquid-gooey": "^0.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "thinking-orbs": "^0.3.2",
    "uqr": "^0.1.3",
    "voice-ring": "^0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
